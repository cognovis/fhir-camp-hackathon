# Copy to .env (git ignores it) and fill in.

# Your free Aidbox development license key, from the Aidbox user portal
# (https://aidbox.app/ui/portal, "Licenses" > new "Development" license > "Self-hosted").
# Without it, activate in the browser instead: open http://localhost:8080 after
# `docker compose up -d` and sign in with your Aidbox account. Do not leave the line
# uncommented and empty: Aidbox refuses to start with an empty license.
# BOX_LICENSE=paste-your-license-key-here

# Host port for Aidbox. Change it if 8080 is taken; setup and the starter app follow it.
# AIDBOX_PORT=8080

# Host port for the starter app. Change it if 5173 is taken.
# APP_PORT=5173
