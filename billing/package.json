{
  "name": "fhir-camp-billing",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build-catalog": "node build-catalog.mjs",
    "check": "fhir-billing-check evaluate --bundle ../catalog/goz-catalog.bundle.json --bundle ../data/dent-051-palmried.json --as-of 2026-11-16",
    "check:blocked": "fhir-billing-check evaluate --bundle ../catalog/goz-catalog.bundle.json --bundle examples/blocked-cost-plan.json --as-of 2026-11-16",
    "cost-plan": "node cost-plan.mjs",
    "test": "node --test companion-rule.test.mjs",
    "check:companion": "fhir-billing-check evaluate --bundle ../catalog/goz-catalog.bundle.json --bundle examples/companion-cost-plans.json --as-of 2026-11-16"
  },
  "dependencies": {
    "@cognovis/fhir-billing-rules": "0.40.0",
    "@cognovis/fhir-billing-sdk": "0.42.1",
    "@cognovis/fhir-sdk": "0.23.3"
  }
}
