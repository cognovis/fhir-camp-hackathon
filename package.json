{
  "name": "fhir-camp-hackathon",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "app",
    "billing"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "validate": "node scripts/setup.mjs --validate-only",
    "app": "npm --workspace app run dev",
    "billing:check": "npm --workspace billing run check",
    "billing:check:blocked": "npm --workspace billing run check:blocked",
    "cost-plan": "node billing/cost-plan.mjs",
    "build-catalog": "npm --workspace billing run build-catalog",
    "charges-from-plan": "node billing/charges-from-plan.mjs"
  }
}
